PORT=5000
NODE_ENV=development

# Local dev (docker-compose) Postgres — in production (Render/Railway) use DATABASE_URL instead
POSTGRES_DB=archery_tracker
POSTGRES_USER=archery_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Production: Render/Railway provide this automatically
# DATABASE_URL=postgres://user:password@host:port/dbname

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# https://resend.com — create an API key after verifying a sending domain
RESEND_API_KEY=
# "onboarding@resend.dev" only delivers to the Resend account's own email while
# testing. For real delivery to archers, verify a domain in Resend and set this
# to an address on it, e.g. "Archery Tracker Kenya <noreply@yourdomain.co.ke>"
EMAIL_FROM=Archery Tracker Kenya <onboarding@resend.dev>

CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000
